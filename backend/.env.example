APP_NAME="Éclat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

# Bind `php artisan serve` to all interfaces so the scanner on a phone can reach it.
SERVER_HOST=0.0.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase Postgres. Project Settings -> Database -> Connection string.
# Use the SESSION pooler (port 5432) or the direct connection; the transaction
# pooler (port 6543) is not recommended for Laravel because of prepared statements.
# Pooler username is "postgres.<project-ref>"; direct username is "postgres".
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@eclat.app"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
# Token-based API: keep stateful domains limited to the backend to avoid
# cookie/CSRF middleware interfering with bearer-token requests.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# "log" simulates WhatsApp/email delivery and marks dispatches as sent.
# Set to "live" (with WhatsApp + mail credentials) to hit real providers.
ECLAT_MESSAGING_DRIVER=log

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_FROM=
