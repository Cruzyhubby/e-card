# Copy to .env.production (same folder as docker-compose.prod.yml) and fill in.
# Never commit the real file. Generate APP_KEY with:
#   php artisan key:generate --show

APP_NAME="Éclat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Supabase Postgres (Project Settings -> Database -> Connection string).
# Use the session pooler on port 5432; the transaction pooler (6543) breaks
# Laravel prepared statements.
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@eclat.app"
MAIL_FROM_NAME="${APP_NAME}"

# Public URL of the deployed admin (also used for guest invitation links).
FRONTEND_URL=https://your-domain.example
SANCTUM_STATEFUL_DOMAINS=your-domain.example

# "log" simulates WhatsApp/email/SMS. Set to "live" only when provider credentials exist.
ECLAT_MESSAGING_DRIVER=log

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_FROM=

SMS_PROVIDER=kilakona
KILAKONA_BASE_URL=https://api.kilakona.co.tz
KILAKONA_API_KEY=
KILAKONA_SENDER_ID=
